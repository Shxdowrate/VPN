<Window x:Class="NeonVpn.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NeonVpn.Controls"
        xmlns:v="clr-namespace:NeonVpn.Views"
        Title="VPN" Width="920" Height="620" MinWidth="780" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        FontFamily="{StaticResource Body}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <c:WindowFrame x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка: состояние, вкладки, кнопки окна. Тянуть окно — за пустое место. -->
            <Grid Grid.Row="0" Margin="22,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StateColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="VPN" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,32,0"/>

                    <RadioButton x:Name="NavHome" Style="{StaticResource Tab}" Content="Главная" IsChecked="True" Checked="OnNav" GroupName="nav" Height="28"/>
                    <RadioButton x:Name="NavServers" Style="{StaticResource Tab}" Content="Серверы" Checked="OnNav" GroupName="nav" Height="28"/>
                    <RadioButton x:Name="NavTunnels" Style="{StaticResource Tab}" Content="Туннели" Checked="OnNav" GroupName="nav" Height="28"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Tab}" Content="Настройки" Checked="OnNav" GroupName="nav" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Мини-окно" Click="OnMini"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Свернуть" Click="OnMinimize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Скрыть в трей" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Line}"/>

            <Grid Grid.Row="1" Margin="24,18,24,20">
                <v:HomeView x:Name="Home"/>
                <v:ServersView x:Name="ServersPage" Visibility="Collapsed"/>
                <v:TunnelsView x:Name="Tunnels" Visibility="Collapsed"/>
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>

            <!-- Сообщение снизу -->
            <Border x:Name="ToastBox" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,9" MaxWidth="600"
                    CornerRadius="8" Background="{DynamicResource Panel2}" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                    Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Dim}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="540"/>
                </StackPanel>
            </Border>
        </Grid>
    </c:WindowFrame>
</Window>

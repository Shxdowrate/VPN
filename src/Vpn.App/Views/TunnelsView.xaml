<UserControl x:Class="NeonVpn.Views.TunnelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Общие правила ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel Margin="0,4,6,0">
                <TextBlock Text="Раздельное туннелирование" Style="{StaticResource H1}" FontSize="20"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,16"
                           Text="Решаешь, что идёт через VPN, а что — напрямую. Работает и в TUN, и в режиме прокси. Изменения применяются сразу."/>

                <TextBlock Text="ВСЁ ОСТАЛЬНОЕ" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                <WrapPanel>
                    <RadioButton x:Name="DefVpn" Style="{StaticResource RadioChip}" GroupName="def" Click="OnDefault">ЧЕРЕЗ VPN</RadioButton>
                    <RadioButton x:Name="DefDirect" Style="{StaticResource RadioChip}" GroupName="def" Click="OnDefault">НАПРЯМУЮ</RadioButton>
                </WrapPanel>
                <TextBlock x:Name="DefHint" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,16"/>

                <TextBlock Text="ГОТОВЫЕ ПРАВИЛА" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                <CheckBox x:Name="RuDirect" Click="OnPreset">
                    <TextBlock Style="{StaticResource BodyText}">Российские сайты и IP — напрямую<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">банки, госуслуги, ВК, Яндекс не ругаются на VPN</Run></TextBlock>
                </CheckBox>
                <CheckBox x:Name="LanDirect" Click="OnPreset">
                    <TextBlock Style="{StaticResource BodyText}">Локальная сеть — напрямую<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">роутер, принтер, NAS, телевизор</Run></TextBlock>
                </CheckBox>
                <CheckBox x:Name="Ads" Click="OnPreset">
                    <TextBlock Style="{StaticResource BodyText}">Блокировать рекламу и трекеры</TextBlock>
                </CheckBox>

                <TextBlock Text="БЫСТРО ДОБАВИТЬ" Style="{StaticResource Caps}" Margin="0,18,0,6"/>
                <WrapPanel x:Name="QuickPanel"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Свои правила ===== -->
        <DockPanel Grid.Column="1" Margin="0,4,4,0">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel>
                        <RadioButton x:Name="KindApp" Style="{StaticResource RadioChip}" GroupName="kind" IsChecked="True" Click="OnKind">ПРОГРАММА</RadioButton>
                        <RadioButton x:Name="KindDomain" Style="{StaticResource RadioChip}" GroupName="kind" Click="OnKind">САЙТ</RadioButton>
                        <RadioButton x:Name="KindIp" Style="{StaticResource RadioChip}" GroupName="kind" Click="OnKind">IP / ПОДСЕТЬ</RadioButton>
                        <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="4,0,10,6"/>
                        <RadioButton x:Name="ActVpn" Style="{StaticResource RadioChip}" GroupName="act" IsChecked="True">VPN</RadioButton>
                        <RadioButton x:Name="ActDirect" Style="{StaticResource RadioChip}" GroupName="act">НАПРЯМУЮ</RadioButton>
                        <RadioButton x:Name="ActBlock" Style="{StaticResource RadioChip}" GroupName="act">БЛОК</RadioButton>
                    </WrapPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SolidButton}" Content="ДОБАВИТЬ" Click="OnAdd" Margin="8,0,0,0"/>
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource NeonButton}" Content="ОБЗОР…" Click="OnBrowse" Margin="8,0,0,0"/>
                        <Button x:Name="RunningButton" DockPanel.Dock="Right" Style="{StaticResource NeonButton}" Content="ЗАПУЩЕННЫЕ ▾" Click="OnRunning" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource Accent2}" Foreground="{DynamicResource Accent2}"/>
                        <TextBox x:Name="Input" KeyDown="OnInputKey"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock x:Name="Count" Style="{StaticResource Caps}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                <TextBlock Text="СВОИ ПРАВИЛА" Style="{StaticResource Caps}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="2,6,0,0"
                       Text="Порядок не важен: сайт важнее программы, поддомен важнее домена. Клик по метке — сменить действие."/>

            <Grid>
                <ListBox x:Name="Rules" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource Dim}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Display}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="2" Click="OnCycle" Cursor="Hand" ToolTip="Сменить действие" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="2,8,2,8" BorderThickness="1" Padding="10,3" Background="Transparent">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{Binding ActionColor}"/>
                                                </Border.BorderBrush>
                                                <TextBlock Text="{Binding ActionText}" FontFamily="{StaticResource Display}" FontSize="11.5">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding ActionColor}"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource CloseButton}" Content="&#xE74D;" ToolTip="Удалить" Click="OnDelete"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyRules" Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                           Text="Своих правил нет. Например: Discord.exe — через VPN, steam.exe — напрямую, youtube.com — через VPN."/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

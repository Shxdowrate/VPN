<Window x:Class="NeonVpn.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NeonVpn.Controls"
        Title="VPN" Width="340" Height="168" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Body}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/Assets/app.ico">

    <c:WindowFrame x:Name="Root">
        <Grid Margin="16,14,10,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка, сервер, управление окном -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <c:PowerButton x:Name="Power" Width="44" Height="44" Margin="0,0,14,0" Click="OnPower"
                               StateColor="{Binding StateColor}" Busy="{Binding Busy}" Lit="{Binding Lit}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ServerCountry, Mode=OneWay}" Foreground="{DynamicResource Dim}"/><Run Text=" "/><Run Text="{Binding ServerName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding StateText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Uptime, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-4,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Большое окно" Click="OnExpand" Width="28"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Скрыть в трей" Click="OnClose" Width="28"/>
                </StackPanel>
            </Grid>

            <!-- Показатели: VPN и напрямую -->
            <Grid Grid.Row="1" Margin="0,14,6,0" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="0.55*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="1" Text="↓" Style="{StaticResource Caps}"/>
                <TextBlock Grid.Column="2" Text="↑" Style="{StaticResource Caps}"/>
                <TextBlock Grid.Column="3" Text="пинг" Style="{StaticResource Caps}"/>
                <TextBlock Grid.Column="4" Text="потери" Style="{StaticResource Caps}"/>

                <TextBlock Grid.Row="1" Text="VPN" Style="{StaticResource Caps}" Foreground="{DynamicResource Text}" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Vpn.Down}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Vpn.Up}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Vpn.Ping}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,4,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding Vpn.PingColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Vpn.Loss}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,4,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding Vpn.LossColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Grid.Row="2" Text="Напрямую" Style="{StaticResource Caps}" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Direct.Down}" Style="{StaticResource Metric}" FontSize="12.5" Foreground="{DynamicResource Dim}" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Direct.Up}" Style="{StaticResource Metric}" FontSize="12.5" Foreground="{DynamicResource Dim}" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Direct.Ping}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,3,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding Direct.PingColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Direct.Loss}" Style="{StaticResource Metric}" FontSize="12.5" Margin="0,3,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding Direct.LossColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Grid>
    </c:WindowFrame>
</Window>

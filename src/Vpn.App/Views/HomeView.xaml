<UserControl x:Class="NeonVpn.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NeonVpn.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Левая колонка: кнопка, сервер, выбор ===== -->
        <StackPanel Grid.Column="0" Margin="0,4,22,0">
            <c:PowerButton x:Name="Power" Width="176" Height="176" Margin="0,22,0,10" HorizontalAlignment="Center" Click="OnPower"
                           StateColor="{Binding StateColor}" Busy="{Binding Busy}" Lit="{Binding Lit}"/>

            <TextBlock Text="{Binding Power}" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="12" Margin="0,22,0,0">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding StateColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="{Binding Uptime}" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="12"
                       Foreground="{DynamicResource Dim}" Margin="0,2,0,16"/>

            <!-- Сервер -->
            <Border Style="{StaticResource Card}" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="OnServerCard" ToolTip="Открыть список серверов">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="28" CornerRadius="2,8,2,8" BorderBrush="{DynamicResource Accent2}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ServerCountry}" FontFamily="{StaticResource Display}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ServerName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ServerPing}" FontFamily="{StaticResource Display}" FontSize="12" Foreground="{DynamicResource Dim}"
                               VerticalAlignment="Top" Margin="8,2,0,0"/>
                </Grid>
            </Border>

            <!-- Как выбран сервер -->
            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                <TextBlock x:Name="TargetIcon" Text="&#xE945;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TargetText}" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource SolidButton}" Click="OnBest" Margin="0,0,8,8"
                        ToolTip="Пингую все серверы, подключаю самый быстрый и фиксирую его — дальше он не меняется">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ЛУЧШИЙ"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AutoButton" Style="{StaticResource NeonButton}" Click="OnAuto" Margin="0,0,8,8"
                        ToolTip="«Авто» сам держит самый быстрый сервер среди всех, подписки или группы">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="АВТО"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NeonButton}" Click="OnServerCard" Margin="0,0,8,8" BorderBrush="{DynamicResource Accent2}" Foreground="{DynamicResource Accent2}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="СЕРВЕРЫ"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Режим -->
            <TextBlock Text="РЕЖИМ" Style="{StaticResource Caps}" Margin="2,12,0,6"/>
            <WrapPanel>
                <ToggleButton x:Name="TunChip" Style="{StaticResource Chip}" Click="OnMode" ToolTip="Виртуальный адаптер: весь трафик системы — игры, мессенджеры, всё">TUN</ToggleButton>
                <ToggleButton x:Name="ProxyChip" Style="{StaticResource Chip}" Click="OnMode" ToolTip="Системный прокси Windows: браузеры и программы, которые его понимают">ПРОКСИ</ToggleButton>
                <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="4,0,10,6"/>
                <RadioButton x:Name="CoreSing" Style="{StaticResource RadioChip}" GroupName="core" Click="OnCore">SING-BOX</RadioButton>
                <RadioButton x:Name="CoreXray" Style="{StaticResource RadioChip}" GroupName="core" Click="OnCore">XRAY</RadioButton>
            </WrapPanel>
        </StackPanel>

        <!-- ===== Правая колонка: два пути трафика ===== -->
        <Grid Grid.Column="1" Margin="0,10,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" DataContext="{Binding Vpn}" BorderBrush="{DynamicResource AccentSoft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" Effect="{DynamicResource GlowAccent}" Margin="0,0,10,0"/>
                        <TextBlock Text="ЧЕРЕЗ VPN" Style="{StaticResource Caps}" FontSize="12.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Total}" Style="{StaticResource Caps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="↓ ЗАГРУЗКА" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Down}" Style="{StaticResource Metric}" Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="↑ ОТДАЧА" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Up}" Style="{StaticResource Metric}" Foreground="{DynamicResource Accent2}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ПИНГ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Ping}" Style="{StaticResource Metric}" FontSize="17">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding PingColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" FontSize="11">
                                <Run Text="ср. "/><Run Text="{Binding PingAvg, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ПОТЕРИ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Loss}" Style="{StaticResource Metric}" FontSize="17">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding LossColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding Jitter}" Style="{StaticResource Hint}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="СОЕДИНЕНИЙ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Conns}" Style="{StaticResource Metric}" FontSize="17"/>
                        </StackPanel>
                    </Grid>

                    <c:Sparkline Grid.Row="2" Down="{Binding DownHist}" Up="{Binding UpHist}" MinHeight="50"
                                 Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" DataContext="{Binding Direct}" BorderBrush="{DynamicResource Accent2Soft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Accent2}" Effect="{DynamicResource GlowAccent2}" Margin="0,0,10,0"/>
                        <TextBlock Text="НАПРЯМУЮ" Style="{StaticResource Caps}" FontSize="12.5" Foreground="{DynamicResource Accent2}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Total}" Style="{StaticResource Caps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="↓ ЗАГРУЗКА" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Down}" Style="{StaticResource Metric}" Foreground="{DynamicResource Accent2}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="↑ ОТДАЧА" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Up}" Style="{StaticResource Metric}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ПИНГ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Ping}" Style="{StaticResource Metric}" FontSize="17">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding PingColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" FontSize="11">
                                <Run Text="ср. "/><Run Text="{Binding PingAvg, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ПОТЕРИ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Loss}" Style="{StaticResource Metric}" FontSize="17">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding LossColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding Jitter}" Style="{StaticResource Hint}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="СОЕДИНЕНИЙ" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Conns}" Style="{StaticResource Metric}" FontSize="17"/>
                        </StackPanel>
                    </Grid>

                    <c:Sparkline Grid.Row="2" Down="{Binding DownHist}" Up="{Binding UpHist}" MinHeight="50"
                                 Color="{DynamicResource Accent2Color}" Color2="{DynamicResource AccentColor}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

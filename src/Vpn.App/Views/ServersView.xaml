<UserControl x:Class="NeonVpn.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Источники: все / подписки / группы ===== -->
        <DockPanel Grid.Column="0" Margin="0,4,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Добавить подписку" Click="OnAddSubscription"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Вставить ссылки серверов" Click="OnPasteLinks"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE902;" ToolTip="Новая группа" Click="OnNewGroup"/>
                </StackPanel>
                <TextBlock Text="ИСТОЧНИКИ" Style="{StaticResource Caps}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>

            <ListBox x:Name="SourceList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}" SelectionChanged="OnSourceChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource Dim}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Info}" Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,2,0,0">
                                <TextBlock Text="&#xE8EE;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"
                                           Visibility="{Binding IsAutoTarget, Converter={StaticResource Vis}}" ToolTip="«Авто» выбирает здесь"
                                           Effect="{DynamicResource GlowSoft}"/>
                                <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Display}" FontSize="12" Foreground="{DynamicResource Dim}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Серверы выбранного источника ===== -->
        <DockPanel Grid.Column="1" Margin="0,0,4,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Title" Style="{StaticResource H1}" FontSize="20" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubTitle" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="UpdateButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить подписку" Click="OnUpdate"/>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Ещё" Click="OnMore"/>
                </StackPanel>
            </Grid>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Style="{StaticResource SolidButton}" Click="OnBestHere" Margin="0,0,8,6"
                        ToolTip="Пингую серверы этого списка, подключаю самый быстрый и фиксирую его">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ЛУЧШИЙ ЗДЕСЬ"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AutoHere" Style="{StaticResource NeonButton}" Click="OnAutoHere" Margin="0,0,8,6"
                        ToolTip="«Авто» будет сам держать самый быстрый сервер из этого списка">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="АВТО ЗДЕСЬ"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NeonButton}" Click="OnPing" Margin="0,0,8,6" BorderBrush="{DynamicResource Accent2}" Foreground="{DynamicResource Accent2}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC48;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ПИНГ"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="SortChip" Style="{StaticResource Chip}" Click="OnSort" Margin="4,0,6,6" ToolTip="Сортировать по пингу">ПО ПИНГУ</ToggleButton>
                <ToggleButton x:Name="OnlyOnChip" Style="{StaticResource Chip}" Click="OnSort" Margin="0,0,6,6" ToolTip="Показывать только включённые">ТОЛЬКО ВКЛ.</ToggleButton>
            </WrapPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE73A;" ToolTip="Включить все в списке" Click="OnAllOn"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE739;" ToolTip="Выключить все в списке" Click="OnAllOff"/>
                </StackPanel>
                <TextBox x:Name="Search" Tag="Поиск: страна, имя, протокол…" TextChanged="OnSearch"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="2,6,0,0"
                       Text="Галочка — сервер участвует в «Авто» и «Лучшем». Двойной клик — подключить. Правая кнопка — группы и прочее."/>

            <Grid>
                <ListBox x:Name="ServerList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                         SelectionMode="Extended" MouseDoubleClick="OnServerDoubleClick" ContextMenuOpening="OnServerMenu">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center" Click="OnIncludeClick" Margin="0"
                                          ToolTip="Участвует в «Авто» и «Лучшем»"/>
                                <Border Grid.Column="1" Width="36" Height="24" CornerRadius="2,7,2,7" BorderThickness="1" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource Line}">
                                    <TextBlock Text="{Binding Country}" FontFamily="{StaticResource Display}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent2}"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="{Binding Source, Mode=OneWay}"/><Run Text="{Binding Groups, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="8,0,4,0" MinWidth="70">
                                    <TextBlock Text="{Binding Ping}" FontFamily="{StaticResource Display}" FontSize="12.5" HorizontalAlignment="Right">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding PingColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="···" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{DynamicResource Accent2}" HorizontalAlignment="Right"
                                               Visibility="{Binding Pinging, Converter={StaticResource Vis}}"/>
                                </Grid>
                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" Effect="{DynamicResource GlowAccent}"
                                             Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" ToolTip="Подключено сейчас"/>
                                    <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Warn}" Margin="0,0,0,16"
                                               Visibility="{Binding IsFixed, Converter={StaticResource Vis}}" ToolTip="Зафиксирован"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Dim2}" Margin="0,0,0,14"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextAlignment="Center" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Style="{StaticResource SolidButton}" Content="ДОБАВИТЬ ПОДПИСКУ" Click="OnAddSubscription" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource NeonButton}" Content="ВСТАВИТЬ ССЫЛКИ" Click="OnPasteLinks"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

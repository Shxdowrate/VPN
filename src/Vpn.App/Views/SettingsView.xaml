<UserControl x:Class="NeonVpn.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Ядро -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ЯДРО" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <RadioButton x:Name="CoreSing" Style="{StaticResource RadioChip}" GroupName="core" Click="OnCore">SING-BOX</RadioButton>
                            <RadioButton x:Name="CoreXray" Style="{StaticResource RadioChip}" GroupName="core" Click="OnCore">XRAY</RadioButton>
                        </WrapPanel>
                        <TextBlock x:Name="CoreHint" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,8"/>
                        <CheckBox x:Name="Fragment" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">Фрагментация TLS (Xray)<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">режет ClientHello на куски — помогает, когда мобильный оператор душит VPN</Run></TextBlock>
                        </CheckBox>
                        <TextBlock x:Name="CoreFiles" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Режим -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="РЕЖИМ" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="Tun" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">TUN — виртуальный адаптер<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">весь трафик системы: игры, мессенджеры, всё</Run></TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="SysProxy" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">Системный прокси Windows<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">браузеры и программы, которые его понимают; можно вместе с TUN</Run></TextBlock>
                        </CheckBox>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Порт прокси" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="120"/>
                            <TextBox x:Name="Port" Width="90" HorizontalAlignment="Left" LostFocus="OnChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="Lan" Click="OnChanged" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource BodyText}">Пускать устройства из локальной сети<LineBreak/><Run Foreground="{DynamicResource Dim}" FontSize="11.5">телефон или приставка смогут ходить через этот ПК по порту прокси</Run></TextBlock>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Авто -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="АВТО-ВЫБОР" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <TextBlock Text="Перепроверять серверы" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="Intervals"/>
                        <TextBlock Text="Переходить, если новый быстрее хотя бы на" Style="{StaticResource Hint}" Margin="0,6,0,4"/>
                        <WrapPanel x:Name="Tolerances"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,8"
                                   Text="Если сервер замолчал на ~10 секунд, а интернет напрямую есть, «Авто» уходит на другой сразу. Кнопка «Лучший» фиксирует сервер — его «Авто» не трогает."/>
                        <TextBlock Text="Адрес проверки (только https)" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TestUrl" LostFocus="OnChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Вид -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="СВЕЧЕНИЕ" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="ColorPanel"/>
                        <TextBlock Text="Силуэт окна" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                        <WrapPanel>
                            <RadioButton x:Name="ShapeBlade" Style="{StaticResource RadioChip}" GroupName="shape" Click="OnLook" Tag="Blade">КЛИНОК</RadioButton>
                            <RadioButton x:Name="ShapeShard" Style="{StaticResource RadioChip}" GroupName="shape" Click="OnLook" Tag="Shard">ОСКОЛОК</RadioButton>
                            <RadioButton x:Name="ShapeCapsule" Style="{StaticResource RadioChip}" GroupName="shape" Click="OnLook" Tag="Capsule">КАПСУЛА</RadioButton>
                        </WrapPanel>
                        <TextBlock Text="Яркость" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                        <WrapPanel>
                            <RadioButton x:Name="Glow1" Style="{StaticResource RadioChip}" GroupName="glow" Click="OnLook" Tag="0.6">МЯГКО</RadioButton>
                            <RadioButton x:Name="Glow2" Style="{StaticResource RadioChip}" GroupName="glow" Click="OnLook" Tag="1.0">НОРМА</RadioButton>
                            <RadioButton x:Name="Glow3" Style="{StaticResource RadioChip}" GroupName="glow" Click="OnLook" Tag="1.3">ЯРКО</RadioButton>
                            <RadioButton x:Name="Glow4" Style="{StaticResource RadioChip}" GroupName="glow" Click="OnLook" Tag="1.6">УЛЬТРА</RadioButton>
                        </WrapPanel>
                        <CheckBox x:Name="Anim" Click="OnLook" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource BodyText}">Бегущий перелив по рамке</TextBlock>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Запуск -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ЗАПУСК" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AutostartBox" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">Запускать вместе с Windows</TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="AutoConnect" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">Сразу подключаться при запуске</TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="StartHidden" Click="OnChanged">
                            <TextBlock Style="{StaticResource BodyText}">При автозапуске — только в трее</TextBlock>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- DNS -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DNS" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <TextBlock Text="Для сайтов через VPN (DoH, идёт через сервер)" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RemoteDns" LostFocus="OnChanged"/>
                        <TextBlock Text="Для сайтов напрямую (DoH или «system» — DNS Windows)" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                        <TextBox x:Name="LocalDns" LostFocus="OnChanged"/>
                    </StackPanel>
                </Border>

                <!-- Служебное -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="СЛУЖЕБНОЕ" Style="{StaticResource Caps}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Style="{StaticResource NeonButton}" Content="ЖУРНАЛ" Click="OnLog" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource NeonButton}" Content="ПАПКА ДАННЫХ" Click="OnData" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource NeonButton}" Content="ВЫХОД" Click="OnExit" Margin="0,0,8,6" BorderBrush="{DynamicResource Bad}" Foreground="{DynamicResource Bad}"/>
                        </WrapPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

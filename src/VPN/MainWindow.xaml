<Window x:Class="VPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN" Width="1080" Height="704" MinWidth="900" MinHeight="620"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" FontFamily="{StaticResource Ui}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">

    <!--
        Окно прозрачное и без рамки. Видны два «острова»: узкая рельса навигации слева и фигурный корпус.
        У корпуса правая колонка (кнопка и статус) приподнята над левой, а снизу — наоборот; переходы — плавные S-кривые.
        По кромке корпуса бежит неоновый свет, цвет которого зависит от состояния: фиолетово-синий — отключено,
        янтарный — подключение, зелёно-бирюзовый — подключено, красный — ошибка. Форма строится в коде (BuildBodyShape).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Живой цвет состояния: из кода подменяется на анимируемую кисть -->
        <SolidColorBrush x:Key="Live" Color="#8B6CFF"/>

        <Geometry x:Key="IcoServers">M4,5 H20 V10 H4 Z M4,14 H20 V19 H4 Z M7,7.5 H8 M7,16.5 H8</Geometry>
        <Geometry x:Key="IcoTunnels">M4,7 H14 L11,4 M14,7 L11,10 M20,17 H10 L13,14 M10,17 L13,20</Geometry>
        <Geometry x:Key="IcoSub">M10,14 L14,10 M8.5,16.5 L7,18 A3.5,3.5 0 0 1 2,13 L5.5,9.5 A3.5,3.5 0 0 1 10.5,9.5 M15.5,7.5 L17,6 A3.5,3.5 0 0 1 22,11 L18.5,14.5 A3.5,3.5 0 0 1 13.5,14.5</Geometry>
        <Geometry x:Key="IcoSettings">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>
        <Geometry x:Key="IcoPin">M9,4 H15 M10,4 V10 L7,14 H17 L14,10 V4 M12,14 V20</Geometry>
        <Geometry x:Key="IcoStar">M12,3 L14.6,8.6 L20.6,9.3 L16.1,13.4 L17.4,19.4 L12,16.3 L6.6,19.4 L7.9,13.4 L3.4,9.3 L9.4,8.6 Z</Geometry>
        <Geometry x:Key="IcoRefresh">M19,8 A8,8 0 1 0 20,13 M19,3 V8 H14</Geometry>
        <Geometry x:Key="IcoTrash">M5,7 H19 M9,7 V4.5 H15 V7 M7,7 L8,20 H16 L17,7 M10.5,11 V16 M13.5,11 V16</Geometry>
        <Geometry x:Key="IcoPaste">M9,4 H15 V7 H9 Z M7,5.5 H5.5 V20.5 H18.5 V5.5 H17 M9,12 H15 M9,16 H13</Geometry>
        <Geometry x:Key="IcoBolt">M13,2 L5,13 H11 L10,22 L19,10 H13 Z</Geometry>
        <Geometry x:Key="IcoCopy">M8,8 H19 V20 H8 Z M5,16 V4 H15</Geometry>

        <!-- ============================================================ строка сервера -->
        <DataTemplate x:Key="ServerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="26" CornerRadius="8" Background="#1F2738" HorizontalAlignment="Left"
                        BorderBrush="#2A3346" BorderThickness="1">
                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource SubText}" FontSize="10.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Протокол: свой цвет у каждого -->
                <Border Grid.Column="2" CornerRadius="7" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                        BorderBrush="{Binding ProtoBrush}" BorderThickness="1" Visibility="{Binding ProtoVisibility}">
                    <TextBlock Text="{Binding Proto}" Foreground="{Binding ProtoBrush}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,2,0" MinWidth="58">
                    <Ellipse Width="6" Height="6" Fill="{Binding PingBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                             Visibility="{Binding PingDotVisibility}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="{Binding PingColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="4" Click="OnFavoriteToggle" Cursor="Hand" ToolTip="В избранное — будет наверху списка"
                        Visibility="{Binding StarVisibility}" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="5">
                                <Path x:Name="Star" Data="{StaticResource IcoStar}" Width="15" Height="15" Stretch="Uniform"
                                      Stroke="{StaticResource Faint}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                                    <Setter TargetName="Star" Property="Fill" Value="{StaticResource Warn}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Заголовок группы серверов (подписка, «Избранное») -->
        <DataTemplate x:Key="ServerGroupHeader">
            <DockPanel Margin="4,10,6,7">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Foreground="{StaticResource Faint}" FontSize="11"/>
                <Ellipse Width="5" Height="5" Fill="{DynamicResource Live}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource SubText}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>

        <!-- ============================================================ строка правила туннеля -->
        <DataTemplate x:Key="RuleRow">
            <Border Background="{StaticResource Card}" CornerRadius="13" Padding="12,7" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Visibility="{Binding ImageVisibility}"/>
                        <Path Data="{Binding Glyph}" Stroke="{Binding GlyphBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="{Binding GlyphVisibility}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Действие: клик переключает VPN → напрямую → блок -->
                    <Button Grid.Column="2" Click="OnRuleToggle" Cursor="Hand" Margin="10,0,4,0" Focusable="False"
                            ToolTip="Нажми, чтобы переключить: через VPN → напрямую → заблокировать">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="10" Padding="11,4" Background="#173A2E" BorderBrush="#2B6B52" BorderThickness="1" MinWidth="86">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse x:Name="ChipDot" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ChipText" Text="через VPN" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActionKey}" Value="direct">
                                        <Setter TargetName="Chip" Property="Background" Value="#3A2E1A"/>
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#6B5226"/>
                                        <Setter TargetName="ChipDot" Property="Fill" Value="{StaticResource Warn}"/>
                                        <Setter TargetName="ChipText" Property="Text" Value="напрямую"/>
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionKey}" Value="block">
                                        <Setter TargetName="Chip" Property="Background" Value="#3A1A22"/>
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#6B2635"/>
                                        <Setter TargetName="ChipDot" Property="Fill" Value="{StaticResource Danger}"/>
                                        <Setter TargetName="ChipText" Property="Text" Value="блок"/>
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource DangerIconButton}" Width="28" Height="28" Click="OnRuleDelete" ToolTip="Удалить">
                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================================================ карточка подписки -->
        <DataTemplate x:Key="SubCard">
            <Border Style="{StaticResource CardBorder}" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" Margin="8,0,0,0" Background="{Binding ExpireBack}"
                                    Visibility="{Binding ExpireVisibility}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpireText}" Foreground="{Binding ExpireBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TrafficText}" Foreground="{StaticResource SubText}" FontSize="12.5" Margin="0,6,0,8" TextWrapping="Wrap"/>
                        <Grid Height="5" Visibility="{Binding BarVisibility}">
                            <Border Background="#222A3B" CornerRadius="3"/>
                            <Border Background="{Binding BarBrush}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Fraction}" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.7" Color="#2BC8D9"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Label}" FontSize="11.5" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,-3,-6,0">
                        <Button Style="{StaticResource IconButton}" Click="OnSubRefresh" ToolTip="Обновить" Visibility="{Binding RefreshVisibility}"
                                IsEnabled="{Binding NotBusy}">
                            <Path Data="{StaticResource IcoRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnSubCopy" ToolTip="Скопировать ссылку" Visibility="{Binding RefreshVisibility}">
                            <Path Data="{StaticResource IcoCopy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource DangerIconButton}" Click="OnSubDelete" ToolTip="Удалить">
                            <Path Data="{StaticResource IcoTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Профиль маршрутизации в полосе профилей -->
        <DataTemplate x:Key="ProfileChip">
            <Button Click="OnProfilePick" Cursor="Hand" Margin="0,0,6,6" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="13,6" Background="{StaticResource CardDeep}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Faint}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Txt" Text="{Binding Name}" Foreground="{StaticResource SubText}" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent2}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#16223A"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent2}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.4" Color="#2BB3FF"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Строка в окне выбора программ -->
        <DataTemplate x:Key="CandidateRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False"/>
                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13"/>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DropShadowEffect x:Key="IslandShadow" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" RenderingBias="Performance"/>
    </Window.Resources>

    <!-- Почти прозрачный фон (#01) ловит мышь у краёв — за него тянется размер и окно -->
    <Grid x:Name="RootGrid" Background="#01000000" MouseLeftButtonDown="OnDragArea">
        <Grid Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================================== рельса -->
            <Grid x:Name="RailHost" Margin="0,40,0,40" MouseLeftButtonDown="OnDragArea">
                <Border CornerRadius="26" Background="#0C0F15" Effect="{StaticResource IslandShadow}"/>
                <Border CornerRadius="26" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#171C29" Offset="0"/>
                            <GradientStop Color="#11151F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#303B52" Offset="0"/>
                            <GradientStop Color="#1A2030" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <DockPanel Margin="0,16,0,14">
                        <!-- Светящийся «орб» — логотип, цвет состояния -->
                        <Grid DockPanel.Dock="Top" Width="34" Height="34" Margin="0,0,0,20" ToolTip="VPN">
                            <Ellipse x:Name="LogoHalo" Width="34" Height="34" Opacity="0.55">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="LogoStop" Color="#8B6CFF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="14" Height="14" Fill="{DynamicResource Live}">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="LogoGlow" BlurRadius="16" ShadowDepth="0" Opacity="1" Color="#8B6CFF"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="#E9EDF5" Opacity="0.85" Margin="-3,-3,0,0"/>
                        </Grid>

                        <Button x:Name="PinButton" DockPanel.Dock="Bottom" Style="{StaticResource RoundButton}" Click="OnPinToggle" ToolTip="Поверх остальных окон"
                                HorizontalAlignment="Center">
                            <Path x:Name="PinIcon" Data="{StaticResource IcoPin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <StackPanel>
                            <RadioButton x:Name="NavServers" Style="{StaticResource RailItem}" Content="Серверы" Tag="{StaticResource IcoServers}" GroupName="Nav" Click="OnNavClick"/>
                            <RadioButton x:Name="NavTunnels" Style="{StaticResource RailItem}" Content="Туннели" Tag="{StaticResource IcoTunnels}" GroupName="Nav" Click="OnNavClick"/>
                            <RadioButton x:Name="NavSubs" Style="{StaticResource RailItem}" Content="Подписки" Tag="{StaticResource IcoSub}" GroupName="Nav" Click="OnNavClick"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource RailItem}" Content="Настройки" Tag="{StaticResource IcoSettings}" GroupName="Nav" Click="OnNavClick"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================================================================================== корпус -->
            <Grid x:Name="BodyHost" Grid.Column="2" SizeChanged="OnBodySizeChanged">
                <!-- Ореол: та же форма, толстая размытая обводка «бегущим» градиентом -->
                <Path x:Name="BodyGlow" StrokeThickness="7" Opacity="0.5" IsHitTestVisible="False">
                    <Path.Stroke>
                        <LinearGradientBrush x:Name="GlowBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="GlowRotate" CenterX="0.5" CenterY="0.5" Angle="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop x:Name="GlowStop1" Color="#8B6CFF" Offset="0"/>
                            <GradientStop x:Name="GlowStop2" Color="#2BB3FF" Offset="0.5"/>
                            <GradientStop x:Name="GlowStop3" Color="#8B6CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.Effect>
                        <BlurEffect Radius="24" RenderingBias="Performance" KernelType="Gaussian"/>
                    </Path.Effect>
                </Path>
                <Path x:Name="BodyShadow" Fill="#0B0E14" Effect="{StaticResource IslandShadow}" IsHitTestVisible="False"/>
                <Path x:Name="BodyFill" IsHitTestVisible="False">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Color="#161B28" Offset="0"/>
                            <GradientStop Color="#11151F" Offset="0.6"/>
                            <GradientStop Color="#0F131C" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Всё содержимое обрезается по форме корпуса -->
                <Grid x:Name="BodyContent" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="372"/>
                    </Grid.ColumnDefinitions>

                    <!-- Правая колонка: чуть светлее — «стекло» -->
                    <Border Grid.Column="1" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0CFFFFFF" Offset="0"/>
                                <GradientStop Color="#04FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Аура за кнопкой: цвет состояния -->
                    <Ellipse Grid.ColumnSpan="2" Width="520" Height="520" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-90,-74,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="AuraStop" Color="#308B6CFF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Светящийся разделитель колонок -->
                    <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,40,0,56" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="DividerStop" Color="#558B6CFF" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ============================================================================ левая колонка: разделы -->
                    <Grid x:Name="ContentArea" Margin="26,34,20,20">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                                <StackPanel x:Name="PageActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="PageTitle" Text="Серверы" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="PageHint" Style="{StaticResource Label}" Margin="1,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <!-- ============================= Серверы -->
                                <DockPanel x:Name="PageServers">
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ServerSearch" Style="{StaticResource Input}" Tag="Поиск: страна, город, протокол…" TextChanged="OnServerSearch"/>
                                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SortList" Style="{StaticResource Segment}" Content="списком" GroupName="Sort" Checked="OnSortChanged" ToolTip="Как в подписке"/>
                                                <RadioButton x:Name="SortPing" Style="{StaticResource Segment}" Content="по пингу" GroupName="Sort" Checked="OnSortChanged" ToolTip="Быстрые — наверху"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="PingAllButton" Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnPingAll" ToolTip="Проверить задержку до всех серверов">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IcoBolt}" Stroke="{StaticResource Warn}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Пинг"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RefreshAllButton" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnRefreshAll" ToolTip="Обновить все подписки">
                                            <Path Data="{StaticResource IcoRefresh}" Stroke="{StaticResource SubText}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <ListBox x:Name="ServersList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ServerRow}" SelectionChanged="OnServerSelected">
                                            <ListBox.GroupStyle>
                                                <GroupStyle HeaderTemplate="{StaticResource ServerGroupHeader}" HidesIfEmpty="True"/>
                                            </ListBox.GroupStyle>
                                        </ListBox>
                                        <StackPanel x:Name="ServersEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="340">
                                            <TextBlock Text="Серверов пока нет" Style="{StaticResource H1}" FontSize="17" HorizontalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource Label}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14"
                                                       Text="Скопируй ссылку на подписку или сервер (vless://, happ://…) и нажми Ctrl + V прямо в этом окне."/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Вставить из буфера" Click="OnPasteImport" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>

                                <!-- ============================= Туннели -->
                                <ScrollViewer x:Name="PageTunnels" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel>
                                        <!-- Профили маршрутизации -->
                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButton}" Content="+ Профиль" Click="OnProfileAdd" ToolTip="Новый профиль — копия текущего"/>
                                            </StackPanel>
                                            <ItemsControl x:Name="ProfilesList" ItemTemplate="{StaticResource ProfileChip}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DockPanel>
                                        <Grid Margin="0,2,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ProfileName" Style="{StaticResource Input}" Tag="Название профиля" LostKeyboardFocus="OnProfileRename" KeyDown="OnProfileNameKey"
                                                     Padding="11,7"/>
                                            <Button x:Name="ProfileDelete" Grid.Column="1" Style="{StaticResource DangerIconButton}" Margin="6,0,0,0" Click="OnProfileDelete" ToolTip="Удалить профиль">
                                                <Path Data="{StaticResource IcoTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>

                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ModeAll" Style="{StaticResource ModeCard}" GroupName="Mode" Margin="0,0,5,0" Checked="OnModeChanged"
                                                         Content="Всё через VPN" Tag="Исключения ниже пойдут напрямую."/>
                                            <RadioButton x:Name="ModeSelected" Style="{StaticResource ModeCard}" GroupName="Mode" Margin="5,0,0,0" Checked="OnModeChanged"
                                                         Content="Только выбранное" Tag="Через VPN — только то, что ниже."/>
                                        </UniformGrid>

                                        <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="15,6">
                                            <StackPanel>
                                                <CheckBox x:Name="RussiaCheck" Style="{StaticResource Switch}" Content="Российские сайты и сервисы напрямую" Click="OnTunnelOption"/>
                                                <CheckBox x:Name="AdsCheck" Style="{StaticResource Switch}" Content="Блокировать рекламу и трекеры" Click="OnTunnelOption"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Быстрое добавление: одна строка понимает всё -->
                                        <Border x:Name="DropZone" CornerRadius="18" BorderThickness="1.5" BorderBrush="{StaticResource Stroke}" Padding="14,13" Margin="0,8,0,0"
                                                Background="{StaticResource CardDeep}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="QuickInput" Style="{StaticResource Input}" Tag="youtube.com, discord.exe, 1.2.3.0/24 или geosite:twitch — и Enter" KeyDown="OnQuickKey"/>
                                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnQuickAdd" Margin="8,0,0,0"/>
                                                </Grid>
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Выбрать программы…" Click="OnPickerOpen"/>
                                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="ActVpn" Style="{StaticResource Segment}" Content="через VPN" GroupName="Act"/>
                                                            <RadioButton x:Name="ActDirect" Style="{StaticResource Segment}" Content="напрямую" GroupName="Act"/>
                                                            <RadioButton x:Name="ActBlock" Style="{StaticResource Segment}" Content="блок" GroupName="Act"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock x:Name="DropHint" Style="{StaticResource Label}" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap"
                                                           Text="Можно перетащить сюда программу или ярлык с рабочего стола, а из браузера — ссылку на сайт."/>
                                                <WrapPanel x:Name="Presets" Margin="0,10,0,-6"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Список правил с фильтром -->
                                        <DockPanel Margin="0,16,0,10">
                                            <TextBlock x:Name="RulesCount" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" Content="Все" GroupName="RuleFilter" Checked="OnRuleFilter" IsChecked="True"/>
                                                    <RadioButton x:Name="FilterApps" Style="{StaticResource Segment}" Content="Программы" GroupName="RuleFilter" Checked="OnRuleFilter"/>
                                                    <RadioButton x:Name="FilterSites" Style="{StaticResource Segment}" Content="Сайты" GroupName="RuleFilter" Checked="OnRuleFilter"/>
                                                    <RadioButton x:Name="FilterOther" Style="{StaticResource Segment}" Content="IP и наборы" GroupName="RuleFilter" Checked="OnRuleFilter"/>
                                                </StackPanel>
                                            </Border>
                                        </DockPanel>
                                        <ItemsControl x:Name="RulesList" ItemTemplate="{StaticResource RuleRow}"/>
                                        <TextBlock x:Name="RulesEmpty" Style="{StaticResource Label}" Margin="2,0,0,4" TextWrapping="Wrap"
                                                   Text="Пока пусто. Добавь сайт или программу выше — например, игры напрямую для низкого пинга."/>
                                        <TextBlock Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap" Margin="2,10,0,6" Foreground="{StaticResource Faint}"
                                                   Text="Порядок важности: блок → сайты и IP → наборы → программы. Если браузер идёт напрямую, а youtube.com — через VPN, YouTube в нём пойдёт через VPN."/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ============================= Подписки -->
                                <ScrollViewer x:Name="PageSubs" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ImportInput" Style="{StaticResource Input}" Tag="Подписка https://…, сервер vless://…, happ://… — и Enter" KeyDown="OnImportKey"/>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnImportAdd" Margin="8,0,0,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="OnPasteImport" Margin="6,0,0,0" ToolTip="Вставить из буфера обмена (Ctrl + V)">
                                                <Path Data="{StaticResource IcoPaste}" Stroke="{StaticResource SubText}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Label}" FontSize="11.5" Margin="2,8,0,14" TextWrapping="Wrap" Foreground="{StaticResource Faint}"
                                                   Text="Понимает ссылки happ://, sing-box://, hiddify://, v2raytun://, а также профили маршрутизации Happ — они появятся в «Туннелях»."/>

                                        <ItemsControl x:Name="SubsList" ItemTemplate="{StaticResource SubCard}"/>
                                        <TextBlock x:Name="SubsEmpty" Style="{StaticResource Label}" Margin="2,0,0,8" Text="Подписок пока нет." Visibility="Collapsed"/>

                                        <TextBlock Text="ОБНОВЛЯТЬ АВТОМАТИЧЕСКИ" Style="{StaticResource H2}"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="Upd6" Style="{StaticResource Segment}" Content="каждые 6 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                                <RadioButton x:Name="Upd12" Style="{StaticResource Segment}" Content="12 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                                <RadioButton x:Name="Upd24" Style="{StaticResource Segment}" Content="24 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,0" FontSize="11.5"
                                                   Text="Ссылки хранятся только на этом компьютере. Никому их не показывай — по ним можно пользоваться твоим VPN."/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ============================= Настройки -->
                                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="ЗАПУСК" Style="{StaticResource H2}" Margin="2,0,0,8"/>
                                        <Border Style="{StaticResource CardBorder}" Padding="15,6">
                                            <StackPanel>
                                                <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch}" Content="Запускать вместе с Windows" Click="OnSettingChanged"/>
                                                <CheckBox x:Name="MinimizedCheck" Style="{StaticResource Switch}" Content="Запускать свёрнутым в трей" Click="OnSettingChanged"/>
                                                <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource Switch}" Content="Подключаться сразу при запуске" Click="OnSettingChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource H2}"/>
                                        <Border Style="{StaticResource CardBorder}" Padding="15,6">
                                            <StackPanel>
                                                <CheckBox x:Name="ReconnectCheck" Style="{StaticResource Switch}" Content="Переподключаться, если связь оборвалась" Click="OnSettingChanged"/>
                                                <CheckBox x:Name="NotifyCheck" Style="{StaticResource Switch}" Content="Уведомления Windows, когда окно скрыто" Click="OnSettingChanged"/>
                                                <CheckBox x:Name="HotkeyCheck" Style="{StaticResource Switch}" Content="Ctrl + Alt + V — включить / выключить VPN" Click="OnSettingChanged"/>
                                                <CheckBox x:Name="TopmostCheck" Style="{StaticResource Switch}" Content="Окно поверх остальных" Click="OnSettingChanged"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="HotkeyNote" Style="{StaticResource Label}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="2,0,0,8"
                                                   Visibility="Collapsed"/>

                                        <TextBlock Text="ССЫЛКИ" Style="{StaticResource H2}"/>
                                        <Border Style="{StaticResource CardBorder}" Padding="15,6">
                                            <StackPanel>
                                                <CheckBox x:Name="HappLinksCheck" Style="{StaticResource Switch}" Content="Открывать ссылки happ:// этой программой" Click="OnSettingChanged"
                                                          ToolTip="Кнопки «Добавить в Happ» на сайтах панелей будут добавлять подписку сюда"/>
                                                <CheckBox x:Name="ClipboardCheck" Style="{StaticResource Switch}" Content="Предлагать добавить ссылку из буфера обмена" Click="OnSettingChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Журнал" Click="OnLogOpen" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Папка с данными" Click="OnOpenData"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AboutText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,8" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>

                        <!-- ============================= выбор программ (поверх раздела) -->
                        <Border x:Name="PickerOverlay" Background="#F2121722" CornerRadius="20" Visibility="Collapsed" Padding="20,16,20,18" Margin="-8,-6,-4,-4"
                                BorderBrush="{StaticResource StrokeHi}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Click="OnPickerClose" ToolTip="Закрыть (Esc)">
                                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="Добавить программы" Style="{StaticResource H1}" FontSize="19" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Найти exe…" Click="OnPickerBrowse"/>
                                    <Button DockPanel.Dock="Right" x:Name="PickerAdd" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnPickerAdd"/>
                                    <TextBlock x:Name="PickerHint" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBox x:Name="PickerSearch" DockPanel.Dock="Top" Style="{StaticResource Input}" Tag="Поиск: discord, chrome, steam…" TextChanged="OnPickerSearch" Margin="0,0,0,10"/>
                                <ListBox x:Name="PickerList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource CandidateRow}" SelectionMode="Single"
                                         SelectionChanged="OnPickerRowClick"/>
                            </DockPanel>
                        </Border>

                        <!-- ============================= журнал (поверх раздела) -->
                        <Border x:Name="LogOverlay" Background="#F2121722" CornerRadius="20" Visibility="Collapsed" Padding="20,16,20,18" Margin="-8,-6,-4,-4"
                                BorderBrush="{StaticResource StrokeHi}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Click="OnLogClose" ToolTip="Закрыть (Esc)">
                                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Копировать" Click="OnLogCopy" Margin="0,0,8,0"/>
                                    <TextBlock Text="Журнал" Style="{StaticResource H1}" FontSize="19" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource CardDeep}" Foreground="{StaticResource SubText}" BorderThickness="0"
                                         FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================================================ правая колонка: кнопка и статус -->
                    <Grid Grid.Column="1" Margin="22,16,22,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка: статус-«капсула» и кнопки окна -->
                        <DockPanel Background="Transparent" MouseLeftButtonDown="OnDragArea">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RoundButton}" Click="OnMinimize" ToolTip="Свернуть" Margin="0,0,6,0">
                                    <Path Data="M5,10 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                </Button>
                                <Button Style="{StaticResource RoundCloseButton}" Click="OnClose" ToolTip="Спрятать в трей">
                                    <Path Data="M6.5,6.5 L13.5,13.5 M13.5,6.5 L6.5,13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                </Button>
                            </StackPanel>
                            <Border x:Name="Pill" HorizontalAlignment="Left" Height="30" CornerRadius="15" Padding="12,0" Background="#0E121B"
                                    BorderThickness="1" BorderBrush="#252E40" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse x:Name="PillDotHalo" Width="8" Height="8" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PillHaloScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="{StaticResource Faint}"/>
                                    </Grid>
                                    <TextBlock x:Name="PillText" Text="Отключено" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PillDetail" Text="" Foreground="{StaticResource SubText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Кнопка, статус, IP -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Grid x:Name="PowerButton" Width="212" Height="212" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonUp="OnPowerClick" RenderTransformOrigin="0.5,0.5" ToolTip="Включить / выключить (Ctrl + Alt + V)">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <!-- Свечение вокруг -->
                                <Ellipse x:Name="Glow" Width="212" Height="212" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop x:Name="GlowStop" Color="#663DDC97" Offset="0.6"/>
                                            <GradientStop Color="#003DDC97" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Шкала-«гребёнка», как на корпусах видеокарт -->
                                <Ellipse Width="192" Height="192" StrokeThickness="6" Stroke="#20283A" StrokeDashArray="0.25,1.55" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TickLive" Width="192" Height="192" StrokeThickness="6" StrokeDashArray="0.25,1.55" Opacity="0"
                                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="TickStop1" Color="#3DDC97" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.55"/>
                                            <GradientStop x:Name="TickStop2" Color="#22D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="TickRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="166" Height="166" StrokeThickness="1" Stroke="#1D2433"/>
                                <Ellipse Width="148" Height="148" StrokeThickness="2.5">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush x:Name="RingBrush" Color="#2A3242"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1C2333" Offset="0"/>
                                            <GradientStop Color="#10141D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="RingGlow" BlurRadius="24" ShadowDepth="0" Opacity="0" Color="#3DDC97"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- Блик сверху диска -->
                                <Ellipse Width="120" Height="60" VerticalAlignment="Center" Margin="0,-70,0,0" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path x:Name="Spinner" Width="148" Height="148" Stretch="None" Opacity="0"
                                      Data="M74,1.25 A72.75,72.75 0 0 1 146.75,74" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.Stroke>
                                        <SolidColorBrush x:Name="SpinnerBrush" Color="#FFB347"/>
                                    </Path.Stroke>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path Width="50" Height="50" Stretch="Uniform" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,3 V11 M7.05,6.05 A7,7 0 1 0 16.95,6.05">
                                    <Path.Stroke>
                                        <SolidColorBrush x:Name="IconBrush" Color="#56607A"/>
                                    </Path.Stroke>
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="IconGlow" BlurRadius="14" ShadowDepth="0" Opacity="0" Color="#3DDC97"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>

                            <TextBlock x:Name="StatusText" Text="Отключено" Style="{StaticResource H1}" FontSize="23" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock x:Name="SubStatus" Text="Нажми на кнопку, чтобы подключиться" Style="{StaticResource Label}" FontSize="12.5"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,5,0,0"/>

                            <!-- Внешний IP: виден, когда подключены. Клик — копировать -->
                            <Button x:Name="IpChip" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnIpCopy"
                                    Visibility="Collapsed" ToolTip="Адрес, который видят сайты. Нажми, чтобы скопировать">
                                <TextBlock x:Name="IpText" FontSize="12" Foreground="{StaticResource SubText}"/>
                            </Button>
                        </StackPanel>

                        <!-- Сервер и профиль -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,10">
                            <Button Style="{StaticResource CardButton}" Click="OnOpenServers" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="30" CornerRadius="9" Background="#1F2738" BorderBrush="#2A3346" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock x:Name="CurrentCode" Text="AUTO" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CurrentGroup" Text="Сервер" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CurrentServer" Text="Самый быстрый" Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CurrentPing" Grid.Column="2" Text="" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ProfileChip" Style="{StaticResource CardButton}" Click="OnProfileChip" ToolTip="Профиль маршрутизации — нажми, чтобы сменить">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M6,8 L10,12 L14,8" Stroke="{StaticResource SubText}" StrokeThickness="1.7" Width="20" Height="20"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IcoTunnels}" Stroke="{StaticResource Accent2}" StrokeThickness="1.6" Width="16" Height="16"
                                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="Маршрутизация · " Foreground="{StaticResource Faint}" FontSize="12"/>
                                        <Run x:Name="ProfileChipText" Text="Основной" Foreground="{StaticResource Text}" FontSize="13"/>
                                    </TextBlock>
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Плитки статистики 2×2 -->
                        <UniformGrid Grid.Row="3" Columns="2">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,4,8" Padding="13,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Загрузка" Style="{StaticResource Label}" FontSize="11.5"/>
                                        <TextBlock x:Name="DownText" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Polyline x:Name="DownLine" Stroke="{StaticResource Accent}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Width="54" Height="20" Stretch="None" StrokeLineJoin="Round">
                                        <Polyline.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#3DDC97"/>
                                        </Polyline.Effect>
                                    </Polyline>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="4,0,0,8" Padding="13,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Отдача" Style="{StaticResource Label}" FontSize="11.5"/>
                                        <TextBlock x:Name="UpText" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Polyline x:Name="UpLine" Stroke="{StaticResource Accent2}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Width="54" Height="20" Stretch="None" StrokeLineJoin="Round">
                                        <Polyline.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#2BB3FF"/>
                                        </Polyline.Effect>
                                    </Polyline>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,4,0" Padding="13,10">
                                <StackPanel>
                                    <TextBlock Text="Пинг · потери" Style="{StaticResource Label}" FontSize="11.5"/>
                                    <TextBlock Margin="0,2,0,0" FontSize="17" FontWeight="SemiBold">
                                        <Run x:Name="PingRun" Text="—" Foreground="{StaticResource Text}"/>
                                        <Run x:Name="LossRun" Text="" Foreground="{StaticResource SubText}" FontSize="12" FontWeight="Normal"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="4,0,0,0" Padding="13,10">
                                <StackPanel>
                                    <TextBlock Text="Сессия" Style="{StaticResource Label}" FontSize="11.5"/>
                                    <TextBlock Margin="0,2,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                                        <Run x:Name="UptimeRun" Text="—"/>
                                        <Run x:Name="TotalRun" Text="" Foreground="{StaticResource SubText}" FontSize="12" FontWeight="Normal"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- Всплывающее уведомление (с необязательной кнопкой действия) -->
                    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,30"
                            Background="#F21A2130" CornerRadius="15" Padding="14,9" Opacity="0" IsHitTestVisible="False"
                            BorderThickness="1" BorderBrush="#33405A">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastShift" Y="0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ToastDot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="380" VerticalAlignment="Center"/>
                            <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" Margin="8,0,-4,0" Visibility="Collapsed" Click="OnToastAction"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Светлая кромка «стекла» и неоновая кромка поверх — по той же форме -->
                <Path x:Name="BodyRim" StrokeThickness="1" IsHitTestVisible="False">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A4660" Offset="0"/>
                            <GradientStop Color="#1C2333" Offset="0.35"/>
                            <GradientStop Color="#161B27" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path x:Name="BodyEdge" StrokeThickness="1.3" Opacity="0.75" IsHitTestVisible="False" Stroke="{Binding Stroke, ElementName=BodyGlow}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

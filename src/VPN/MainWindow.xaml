<Window x:Class="VPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN" Width="836" Height="780" MinWidth="824" MinHeight="690"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" FontFamily="{StaticResource Ui}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Окно прозрачное и без рамки: видно только «острова» — корпус-смартфон с выступом сверху,
        плавающий док снизу и (по требованию) панель слева. Между ними — пустота, сквозь неё кликается рабочий стол.
        Место под левую панель есть в окне всегда, но пока она закрыта, там нет ни одного пикселя —
        Windows пропускает клики насквозь. Так панель выезжает плавно, без «прыжка» окна при изменении размера.
        WindowChrome оставлен только ради системного изменения размера за правый и нижний края.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="IcoServers">M4,5 H20 V10 H4 Z M4,14 H20 V19 H4 Z M7,7.5 H8 M7,16.5 H8</Geometry>
        <Geometry x:Key="IcoTunnels">M4,7 H14 L11,4 M14,7 L11,10 M20,17 H10 L13,14 M10,17 L13,20</Geometry>
        <Geometry x:Key="IcoSub">M10,14 L14,10 M8.5,16.5 L7,18 A3.5,3.5 0 0 1 2,13 L5.5,9.5 A3.5,3.5 0 0 1 10.5,9.5 M15.5,7.5 L17,6 A3.5,3.5 0 0 1 22,11 L18.5,14.5 A3.5,3.5 0 0 1 13.5,14.5</Geometry>
        <Geometry x:Key="IcoSettings">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>
        <Geometry x:Key="IcoPin">M9,4 H15 M10,4 V10 L7,14 H17 L14,10 V4 M12,14 V20</Geometry>
        <Geometry x:Key="IcoStar">M12,3 L14.6,8.6 L20.6,9.3 L16.1,13.4 L17.4,19.4 L12,16.3 L6.6,19.4 L7.9,13.4 L3.4,9.3 L9.4,8.6 Z</Geometry>

        <!-- Строка сервера -->
        <DataTemplate x:Key="ServerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="26" CornerRadius="7" Background="#202838" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource SubText}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0"/>
                <Button Grid.Column="3" Click="OnFavoriteToggle" Cursor="Hand" ToolTip="В избранное — будет наверху списка"
                        Visibility="{Binding StarVisibility}" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4">
                                <Path x:Name="Star" Data="{StaticResource IcoStar}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{StaticResource Faint}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                                    <Setter TargetName="Star" Property="Fill" Value="{StaticResource Warn}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Path Grid.Column="4" Data="M4,10 L8,14 L16,6" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="20" Height="20"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding CheckVisibility}"/>
            </Grid>
        </DataTemplate>

        <!-- Строка правила: программа или сайт -->
        <DataTemplate x:Key="RuleRow">
            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SubtitleVisibility}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnRuleToggle" Cursor="Hand" Margin="10,0,6,0" ToolTip="Нажми, чтобы переключить">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="9" Padding="12,5" Background="#1D3A2E">
                                    <TextBlock x:Name="ChipText" Text="через VPN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ViaVpn}" Value="False">
                                        <Setter TargetName="Chip" Property="Background" Value="#3A2E1D"/>
                                        <Setter TargetName="ChipText" Property="Text" Value="напрямую"/>
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Click="OnRuleDelete" ToolTip="Удалить">
                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Строка в окне выбора программ -->
        <DataTemplate x:Key="CandidateRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13"/>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Тень «острова»: размытая подложка под формой -->
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55" Color="#000000" RenderingBias="Performance"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- 16 (тень) + 420 (панель) | 12 зазор | смартфон + 16 (тень) -->
            <ColumnDefinition Width="436"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================================================== панель слева -->
        <Grid x:Name="DrawerHost" Visibility="Collapsed" Margin="16,16,0,16">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DrawerShift" X="0"/>
            </Grid.RenderTransform>
            <Border CornerRadius="26" Background="#0B0E13" Effect="{StaticResource IslandShadow}"/>
            <Border x:Name="Drawer" CornerRadius="26" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#121720" Offset="0"/>
                        <GradientStop Color="#0C1016" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2C3648" Offset="0"/>
                        <GradientStop Color="#171D27" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid>
                    <DockPanel Margin="22,16,14,18">
                        <!-- Шапка панели: за неё можно тянуть окно -->
                        <DockPanel x:Name="DrawerHeader" DockPanel.Dock="Top" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Click="OnDrawerClose" ToolTip="Свернуть панель (Esc)">
                                <Path Data="M8,5 L13,10 L8,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
                            </Button>
                            <TextBlock x:Name="DrawerTitle" Text="Серверы" Style="{StaticResource H1}" FontSize="22" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,0,8,0">
                            <!-- ============================= Серверы -->
                            <DockPanel x:Name="PageServers" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                                    <TextBlock x:Name="ServerCount" DockPanel.Dock="Left" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Обновить" Click="OnRefreshSubscription"
                                            ToolTip="Скачать подписку заново"/>
                                    <Button x:Name="PingAllButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Пинг" Click="OnPingAll" Margin="0,0,6,0"
                                            ToolTip="Проверить задержку до всех серверов"/>
                                </DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerSearch" Style="{StaticResource Input}" Tag="Поиск сервера…" TextChanged="OnServerSearch"/>
                                    <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="10" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SortList" Style="{StaticResource Segment}" Content="списком" GroupName="Sort" Checked="OnSortChanged"
                                                         ToolTip="Как в подписке"/>
                                            <RadioButton x:Name="SortPing" Style="{StaticResource Segment}" Content="по пингу" GroupName="Sort" Checked="OnSortChanged"
                                                         ToolTip="Быстрые — наверху"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ListBox x:Name="ServersList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ServerRow}" SelectionChanged="OnServerSelected"/>
                            </DockPanel>

                            <!-- ============================= Туннели -->
                            <ScrollViewer x:Name="PageTunnels" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="Выбери, что пускать через VPN, а что напрямую. Изменения применяются сразу."/>

                                    <RadioButton x:Name="ModeAll" Style="{StaticResource ModeCard}" GroupName="Mode" Margin="0,0,0,8" Checked="OnModeChanged"
                                                 Content="Всё через VPN" Tag="Через VPN идёт весь трафик, а то, что добавишь ниже, — напрямую."/>
                                    <RadioButton x:Name="ModeSelected" Style="{StaticResource ModeCard}" GroupName="Mode" Checked="OnModeChanged"
                                                 Content="Только выбранное" Tag="Через VPN идёт только то, что добавишь ниже, остальное — напрямую."/>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="RussiaCheck" Style="{StaticResource Switch}" Content="Российские сайты и сервисы напрямую" Click="OnTunnelOption" Margin="0,2"/>
                                            <CheckBox x:Name="AdsCheck" Style="{StaticResource Switch}" Content="Блокировать рекламу и трекеры" Click="OnTunnelOption" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Программы -->
                                    <DockPanel Margin="0,16,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Программы" Click="OnPickerOpen" Padding="14,7"/>
                                        <TextBlock Text="Программы" Style="{StaticResource H1}" FontSize="17" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource RuleRow}"/>
                                    <TextBlock x:Name="AppsEmpty" Style="{StaticResource Label}" Margin="2,0,0,4" TextWrapping="Wrap"
                                               Text="Пока пусто. Например, добавь игры — они пойдут напрямую с низким пингом."/>

                                    <!-- Сайты -->
                                    <TextBlock Text="Сайты" Style="{StaticResource H1}" FontSize="17" Margin="0,18,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SiteInput" Style="{StaticResource Input}" Tag="youtube.com — и Enter" KeyDown="OnSiteKey"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnSiteAdd" Margin="8,0,0,0" Padding="14,7"/>
                                    </Grid>
                                    <TextBlock Text="Быстро добавить:" Style="{StaticResource Label}" Margin="2,2,0,6"/>
                                    <WrapPanel x:Name="Presets" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="SitesList" ItemTemplate="{StaticResource RuleRow}"/>
                                    <TextBlock x:Name="SitesEmpty" Style="{StaticResource Label}" Margin="2,0,0,4" Text="Пока пусто."/>

                                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,14,0,6"
                                               Text="Сайты важнее программ: если браузер идёт напрямую, а youtube.com — через VPN, YouTube в этом браузере пойдёт через VPN."/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ============================= Подписка -->
                            <ScrollViewer x:Name="PageSub" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SubUrl" Style="{StaticResource Input}" Tag="Ссылка-подписка: https://…"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSubSave" Margin="8,0,0,0" Padding="14,7"/>
                                    </Grid>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="16,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="SubExpireText" DockPanel.Dock="Right" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SubTitleText" Text="Подписка" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock x:Name="SubTrafficText" Text="не добавлена" Foreground="{StaticResource SubText}" FontSize="13" Margin="0,8,0,8" TextWrapping="Wrap"/>
                                            <Grid x:Name="SubBarTrack" Height="6">
                                                <Border Background="#232B38" CornerRadius="3"/>
                                                <Border x:Name="SubBar" Background="{StaticResource AccentGradient}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                            </Grid>
                                            <TextBlock x:Name="SubInfo" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Обновлять автоматически" Style="{StaticResource H2}"/>
                                    <Border Background="{StaticResource Card}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Upd6" Style="{StaticResource Segment}" Content="каждые 6 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                            <RadioButton x:Name="Upd12" Style="{StaticResource Segment}" Content="12 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                            <RadioButton x:Name="Upd24" Style="{StaticResource Segment}" Content="24 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,0"
                                               Text="Ссылка хранится только на этом компьютере. Никому её не показывай — по ней можно пользоваться твоим VPN."/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ============================= Настройки -->
                            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Запуск" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch}" Content="Запускать вместе с Windows" Click="OnSettingChanged"/>
                                            <CheckBox x:Name="MinimizedCheck" Style="{StaticResource Switch}" Content="Запускать свёрнутым в трей" Click="OnSettingChanged"/>
                                            <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource Switch}" Content="Подключаться сразу при запуске" Click="OnSettingChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Подключение" Style="{StaticResource H2}" Margin="0,8,0,8"/>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <CheckBox x:Name="ReconnectCheck" Style="{StaticResource Switch}" Content="Переподключаться, если связь оборвалась" Click="OnSettingChanged"/>
                                            <CheckBox x:Name="NotifyCheck" Style="{StaticResource Switch}" Content="Уведомления Windows, когда окно скрыто" Click="OnSettingChanged"/>
                                            <CheckBox x:Name="HotkeyCheck" Style="{StaticResource Switch}" Content="Ctrl + Alt + V — включить / выключить VPN" Click="OnSettingChanged"/>
                                            <CheckBox x:Name="TopmostCheck" Style="{StaticResource Switch}" Content="Окно поверх остальных" Click="OnSettingChanged"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="HotkeyNote" Style="{StaticResource Label}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="2,0,0,8"
                                               Visibility="Collapsed"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="Журнал" Click="OnLogOpen" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Папка с данными" Click="OnOpenData"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AboutText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>

                    <!-- ============================= выбор программ (поверх панели) -->
                    <Border x:Name="PickerOverlay" Background="#0E1218" Visibility="Collapsed" Padding="20,16,20,18">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Click="OnPickerClose" ToolTip="Закрыть">
                                    <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                </Button>
                                <TextBlock Text="Добавить программы" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Найти exe…" Click="OnPickerBrowse"/>
                                <Button DockPanel.Dock="Right" x:Name="PickerAdd" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnPickerAdd"/>
                                <TextBlock x:Name="PickerHint" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBox x:Name="PickerSearch" DockPanel.Dock="Top" Style="{StaticResource Input}" Tag="Поиск: discord, chrome, steam…" TextChanged="OnPickerSearch" Margin="0,0,0,10"/>
                            <ListBox x:Name="PickerList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource CandidateRow}" SelectionMode="Single"
                                     SelectionChanged="OnPickerRowClick"/>
                        </DockPanel>
                    </Border>

                    <!-- ============================= журнал (поверх панели) -->
                    <Border x:Name="LogOverlay" Background="#0E1218" Visibility="Collapsed" Padding="20,16,20,18">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Click="OnLogClose" ToolTip="Закрыть">
                                    <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Копировать" Click="OnLogCopy" Margin="0,0,8,0"/>
                                <TextBlock Text="Журнал" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource Card}" Foreground="{StaticResource SubText}" BorderThickness="0"
                                     FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================================== «смартфон» -->
        <!-- Почти невидимый фон (#01) вокруг смартфона ловит мышь у краёв — иначе за прозрачные края не потянуть размер -->
        <Grid Grid.Column="2" Background="#01000000" MouseLeftButtonDown="OnDragArea"/>
        <Grid x:Name="PhoneColumn" Grid.Column="2" Margin="0,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Корпус: форма с выступом-«капсулой» сверху строится в коде (BuildBodyShape) под текущий размер -->
            <Grid x:Name="BodyHost" SizeChanged="OnBodySizeChanged">
                <Path x:Name="BodyShadow" Fill="#0B0E13" Effect="{StaticResource IslandShadow}"/>
                <Path x:Name="BodyFill">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141924" Offset="0"/>
                            <GradientStop Color="#0C0F15" Offset="0.55"/>
                            <GradientStop Color="#0A0D12" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Всё содержимое корпуса обрезается по его форме -->
                <Grid x:Name="BodyContent" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                    <!-- Аура за кнопкой: цвет меняется вместе со статусом -->
                    <Ellipse Width="440" Height="440" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-70,0,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="AuraStop" Color="#262A3550" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="18,0,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка: слева логотип и «закрепить», по центру (в выступе) статус, справа свернуть/закрыть -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,30,0,0">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource AccentGradient}" VerticalAlignment="Center" Margin="2,0,8,0"
                                     ToolTip="VPN"/>
                            <Button x:Name="PinButton" Style="{StaticResource RoundButton}" Click="OnPinToggle" ToolTip="Поверх остальных окон">
                                <Path x:Name="PinIcon" Data="{StaticResource IcoPin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,0,0">
                            <Button Style="{StaticResource RoundButton}" Click="OnMinimize" ToolTip="Свернуть" Margin="0,0,6,0">
                                <Path Data="M5,10 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource RoundCloseButton}" Click="OnClose" ToolTip="Спрятать в трей">
                                <Path Data="M6.5,6.5 L13.5,13.5 M13.5,6.5 L6.5,13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>

                        <!-- Статус в «капсуле» -->
                        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" Height="28" MinWidth="118"
                                CornerRadius="14" Padding="12,0" Background="#0D1118" BorderThickness="1" BorderBrush="#222A38" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="PillDotHalo" Width="8" Height="8" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="PillHaloScale" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="{StaticResource Faint}"/>
                                </Grid>
                                <TextBlock x:Name="PillText" Text="Отключено" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PillDetail" Text="" Foreground="{StaticResource SubText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопка, статус, IP -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid x:Name="PowerButton" Width="186" Height="186" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonUp="OnPowerClick" RenderTransformOrigin="0.5,0.5" ToolTip="Включить / выключить (Ctrl + Alt + V)">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="Glow" Width="186" Height="186" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop x:Name="GlowStop" Color="#553DDC97" Offset="0.62"/>
                                            <GradientStop Color="#003DDC97" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Внешнее тонкое кольцо -->
                                <Ellipse Width="176" Height="176" StrokeThickness="1" Stroke="#1C2330"/>
                                <Ellipse Width="156" Height="156" StrokeThickness="3">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush x:Name="RingBrush" Color="#2A3242"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A2130" Offset="0"/>
                                            <GradientStop Color="#10141C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path x:Name="Spinner" Width="156" Height="156" Stretch="None" Opacity="0"
                                      Data="M78,1.5 A76.5,76.5 0 0 1 154.5,78" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.Stroke>
                                        <SolidColorBrush x:Name="SpinnerBrush" Color="#FFB347"/>
                                    </Path.Stroke>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path Width="50" Height="50" Stretch="Uniform" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,3 V11 M7.05,6.05 A7,7 0 1 0 16.95,6.05">
                                    <Path.Stroke>
                                        <SolidColorBrush x:Name="IconBrush" Color="#56607A"/>
                                    </Path.Stroke>
                                </Path>
                            </Grid>

                            <TextBlock x:Name="StatusText" Text="Отключено" Style="{StaticResource H1}" FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="SubStatus" Text="Нажми на кнопку, чтобы подключиться" Style="{StaticResource Label}" FontSize="12.5"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,5,0,0"/>

                            <!-- Внешний IP: виден, когда подключены. Клик — копировать -->
                            <Button x:Name="IpChip" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnIpCopy"
                                    Visibility="Collapsed" ToolTip="Адрес, который видят сайты. Нажми, чтобы скопировать">
                                <TextBlock x:Name="IpText" FontSize="12" Foreground="{StaticResource SubText}"/>
                            </Button>
                        </StackPanel>

                        <!-- Выбранный сервер: клик — панель серверов -->
                        <Button Grid.Row="2" Click="OnOpenServers" Cursor="Hand" Margin="0,8,0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource Card}" CornerRadius="16" Padding="14,11" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#33405A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="28" CornerRadius="8" Background="#202838" Margin="0,0,12,0">
                                    <TextBlock x:Name="CurrentCode" Text="AUTO" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Сервер" Foreground="{StaticResource Faint}" FontSize="11"/>
                                    <TextBlock x:Name="CurrentServer" Text="Самый быстрый" Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="CurrentPing" Grid.Column="2" Text="" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0"/>
                                <Path Grid.Column="3" Data="M12,5 L7,10 L12,15" Stroke="{StaticResource SubText}" StrokeThickness="1.8" Width="20" Height="20" VerticalAlignment="Center"
                                      ToolTip="Список откроется слева"/>
                            </Grid>
                        </Button>

                        <!-- Плитки статистики 2×2 -->
                        <UniformGrid Grid.Row="3" Columns="2">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,5,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Загрузка" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="DownText" Text="—" Style="{StaticResource Value}" FontSize="16" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Polyline x:Name="DownLine" Stroke="{StaticResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Width="54" Height="20" Stretch="None" Opacity="0.8"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="5,0,0,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Отдача" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="UpText" Text="—" Style="{StaticResource Value}" FontSize="16" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Polyline x:Name="UpLine" Stroke="{StaticResource Accent2}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Width="54" Height="20" Stretch="None" Opacity="0.8"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Пинг · потери" Style="{StaticResource Label}"/>
                                    <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold">
                                        <Run x:Name="PingRun" Text="—" Foreground="{StaticResource Text}"/>
                                        <Run x:Name="LossRun" Text="" Foreground="{StaticResource SubText}" FontSize="12" FontWeight="Normal"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сессия" Style="{StaticResource Label}"/>
                                    <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                                        <Run x:Name="UptimeRun" Text="—"/>
                                        <Run x:Name="TotalRun" Text="" Foreground="{StaticResource SubText}" FontSize="12" FontWeight="Normal"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- Всплывающее уведомление (с необязательной кнопкой действия) -->
                    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18"
                            Background="#F2192030" CornerRadius="14" Padding="14,9" Opacity="0" IsHitTestVisible="False"
                            BorderThickness="1" BorderBrush="#2E3A4E">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastShift" Y="0"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ToastDot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="250" VerticalAlignment="Center"/>
                            <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" Margin="8,0,-4,0" Visibility="Collapsed" Click="OnToastAction"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Тонкий контур поверх — по той же форме -->
                <Path x:Name="BodyStroke" StrokeThickness="1" IsHitTestVisible="False">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#34405A" Offset="0"/>
                            <GradientStop Color="#1A2130" Offset="0.4"/>
                            <GradientStop Color="#141A24" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Grid>

            <!-- ============================= плавающий док -->
            <Grid Grid.Row="2" Margin="18,0">
                <Border CornerRadius="24" Background="#0B0E13" Effect="{StaticResource IslandShadow}"/>
                <Border CornerRadius="24" BorderThickness="1" BorderBrush="#232C3B" Background="#10141B" Padding="4,0">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="DockServers" Style="{StaticResource DockItem}" Content="Серверы" Tag="{StaticResource IcoServers}" GroupName="Dock" Click="OnDockClick"/>
                        <RadioButton x:Name="DockTunnels" Style="{StaticResource DockItem}" Content="Туннели" Tag="{StaticResource IcoTunnels}" GroupName="Dock" Click="OnDockClick"/>
                        <RadioButton x:Name="DockSub" Style="{StaticResource DockItem}" Content="Подписка" Tag="{StaticResource IcoSub}" GroupName="Dock" Click="OnDockClick"/>
                        <RadioButton x:Name="DockSettings" Style="{StaticResource DockItem}" Content="Настройки" Tag="{StaticResource IcoSettings}" GroupName="Dock" Click="OnDockClick"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

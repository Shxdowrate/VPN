<Window x:Class="VPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN" Width="1060" Height="690"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Ui}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Карточка сервера в нижней полосе -->
        <DataTemplate x:Key="ServerTemplate">
            <Border x:Name="Card" Width="176" Height="96" Margin="0,0,10,0" CornerRadius="14" Cursor="Hand"
                    Background="{StaticResource Card}" BorderThickness="1.5" BorderBrush="Transparent"
                    MouseLeftButtonUp="OnServerClick" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid Margin="14,11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Code}" Foreground="{StaticResource Faint}" FontSize="12" FontWeight="Bold"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{StaticResource SubText}" FontSize="11"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
                    <Setter TargetName="Card" Property="Background" Value="#16241F"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка правила (программа или сайт) -->
        <DataTemplate x:Key="RuleTemplate">
            <Border Background="{StaticResource Card}" CornerRadius="11" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Subtitle}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnRuleToggle" Cursor="Hand" Margin="8,0" ToolTip="Нажми, чтобы переключить">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="8" Padding="10,4" Background="#1D3A2E">
                                    <TextBlock x:Name="ChipText" Text="через VPN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ViaVpn}" Value="False">
                                        <Setter TargetName="Chip" Property="Background" Value="#3A2E1D"/>
                                        <Setter TargetName="ChipText" Property="Text" Value="напрямую"/>
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnRuleDelete" ToolTip="Удалить">
                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="22" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= заголовок -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleDrag" Margin="12,10,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnMenuOpen" ToolTip="Меню">
                        <Path Data="M3,6 H17 M3,10 H17 M3,14 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
                    </Button>
                    <Ellipse x:Name="TitleDot" Width="8" Height="8" Fill="{StaticResource Faint}" Margin="14,0,8,0"/>
                    <TextBlock Text="VPN" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnMinimize" ToolTip="Свернуть">
                        <Path Data="M5,10 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Спрятать в трей">
                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================================================= кнопка и характеристики -->
            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid x:Name="PowerButton" Width="270" Height="270" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="OnPowerDown" MouseLeftButtonUp="OnPowerUp"
                          MouseEnter="OnPowerEnter" MouseLeave="OnPowerLeave" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Пульсирующий ореол (когда подключено) -->
                        <Ellipse x:Name="Halo" Width="230" Height="230" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#663DDC97" Offset="0.55"/>
                                    <GradientStop Color="#003DDC97" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Кольцо -->
                        <Ellipse Width="230" Height="230" StrokeThickness="3">
                            <Ellipse.Stroke>
                                <SolidColorBrush x:Name="RingBrush" Color="#2A3242"/>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- Крутящаяся дуга (когда подключаемся) -->
                        <Path x:Name="Spinner" Width="230" Height="230" Stretch="None" Opacity="0"
                              Data="M115,1.5 A113.5,113.5 0 0 1 228.5,115" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{StaticResource Warn}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>

                        <!-- Сердцевина -->
                        <Ellipse Width="196" Height="196">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B2230" Offset="0"/>
                                    <GradientStop Color="#121720" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="CoreGlow" BlurRadius="40" ShadowDepth="0" Opacity="0" Color="#3DDC97"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Path Width="70" Height="70" Stretch="Uniform" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,3 V11 M7.05,6.05 A7,7 0 1 0 16.95,6.05">
                            <Path.Stroke>
                                <SolidColorBrush x:Name="IconBrush" Color="#56607A"/>
                            </Path.Stroke>
                        </Path>
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="Отключено" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="SubStatus" Text="Нажми, чтобы подключиться" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>

                <!-- Характеристики -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Загрузка" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DownText" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Polyline x:Name="DownLine" Stroke="{StaticResource Accent}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Width="120" Height="34" Stretch="None" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Отдача" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="UpText" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Polyline x:Name="UpLine" Stroke="{StaticResource Accent2}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Width="120" Height="34" Stretch="None" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Пинг" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="PingText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Потери" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LossText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="За сессию" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Время" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="SubExpireText" DockPanel.Dock="Right" Style="{StaticResource Label}" Text=""/>
                                <TextBlock x:Name="SubTitleText" Text="Подписка" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <TextBlock x:Name="SubTrafficText" Text="не добавлена" Foreground="{StaticResource Text}" FontSize="13" Margin="0,4,0,6"/>
                            <Grid Height="4">
                                <Border Background="#232B38" CornerRadius="2"/>
                                <Border x:Name="SubBar" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================================================= серверы -->
            <StackPanel Grid.Row="2" Margin="24,4,24,22">
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PingAllButton" Style="{StaticResource GhostButton}" Content="Проверить пинг" Click="OnPingAll" Margin="0,0,8,0"/>
                        <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Content="Обновить подписку" Click="OnRefreshSubscription"/>
                    </StackPanel>
                    <TextBlock Text="Серверы" Style="{StaticResource H1}" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerCount" Text="" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnServersWheel" Padding="0,4,0,8">
                    <ItemsControl x:Name="ServersList" ItemTemplate="{StaticResource ServerTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,2,0,2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- ================================================= боковое меню -->
            <Border x:Name="Backdrop" Grid.RowSpan="3" Background="#B0070A0E" Opacity="0" Visibility="Collapsed"
                    CornerRadius="22" MouseLeftButtonDown="OnBackdropClick"/>

            <Border x:Name="Drawer" Grid.RowSpan="3" Width="420" HorizontalAlignment="Left" Background="{StaticResource Panel}"
                    CornerRadius="22,0,0,22" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" X="-440"/>
                </Border.RenderTransform>
                <Grid Margin="22,18,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnMenuClose">
                            <Path Data="M12,5 L7,10 L12,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="20" Height="20"/>
                        </Button>
                        <TextBlock Text="Меню" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,6">
                        <RadioButton x:Name="NavTunnels" Style="{StaticResource NavButton}" Content="Туннели" GroupName="Nav" IsChecked="True" Checked="OnNav"/>
                        <RadioButton x:Name="NavSub" Style="{StaticResource NavButton}" Content="Подписка" GroupName="Nav" Checked="OnNav"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Настройки" GroupName="Nav" Checked="OnNav"/>
                        <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" Content="Журнал" GroupName="Nav" Checked="OnNav"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <!-- Туннели -->
                        <ScrollViewer x:Name="PageTunnels" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Всё остальное" Style="{StaticResource H2}" Margin="0,8,0,8"/>
                                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="DefaultVpn" Style="{StaticResource Segment}" Content="через VPN" GroupName="Default" Checked="OnDefaultRoute"/>
                                        <RadioButton x:Name="DefaultDirect" Style="{StaticResource Segment}" Content="напрямую" GroupName="Default" Checked="OnDefaultRoute"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DefaultHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,8,0,4"/>

                                <CheckBox x:Name="RussiaCheck" Style="{StaticResource Switch}" Content="Российские сайты напрямую" Click="OnTunnelOption"/>
                                <CheckBox x:Name="AdsCheck" Style="{StaticResource Switch}" Content="Блокировать рекламу" Click="OnTunnelOption"/>

                                <DockPanel Margin="0,14,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+ программа" Click="OnAddAppOpen"/>
                                    <TextBlock Text="Программы" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Выбор программы -->
                                <Border x:Name="AppPicker" Background="{StaticResource Card}" CornerRadius="12" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBox x:Name="AppSearch" Style="{StaticResource Input}" Tag="Поиск среди запущенных…" TextChanged="OnAppSearch"/>
                                        <ListBox x:Name="AppCandidates" Height="190" Margin="0,8,0,8" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnAppPick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" CornerRadius="8" Padding="10,6" Background="Transparent" Cursor="Hand">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13"/>
                                                                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#1D3A2E"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Через VPN" Click="OnAppAddVpn" Padding="12,7"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Напрямую" Click="OnAppAddDirect" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Обзор…" Click="OnAppBrowse" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Закрыть" Click="OnAddAppClose" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource RuleTemplate}"/>
                                <TextBlock x:Name="AppsEmpty" Text="Пока ни одной программы" Style="{StaticResource Label}" Margin="2,0,0,6"/>

                                <TextBlock Text="Сайты" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SiteInput" Style="{StaticResource Input}" Tag="например, youtube.com" KeyDown="OnSiteKey"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="VPN" Click="OnSiteAddVpn" Margin="8,0,0,0" Padding="12,7"/>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Прямо" Click="OnSiteAddDirect" Margin="6,0,0,0"/>
                                </Grid>
                                <ItemsControl x:Name="SitesList" ItemTemplate="{StaticResource RuleTemplate}"/>
                                <TextBlock x:Name="SitesEmpty" Text="Пока ни одного сайта" Style="{StaticResource Label}" Margin="2,0,0,6"/>

                                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,16,0,10"
                                           Text="Сайты главнее программ: если браузер идёт напрямую, а youtube.com — через VPN, то YouTube в этом браузере пойдёт через VPN. Изменения применяются сразу."/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Подписка -->
                        <ScrollViewer x:Name="PageSub" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Ссылка-подписка" Style="{StaticResource H2}" Margin="0,8,0,8"/>
                                <TextBox x:Name="SubUrl" Style="{StaticResource Input}" Tag="https://…"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить и обновить" Click="OnSubSave" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <TextBlock x:Name="SubInfo" Style="{StaticResource Body}" Margin="2,14,0,0" Foreground="{StaticResource SubText}"/>

                                <TextBlock Text="Обновлять автоматически" Style="{StaticResource H2}"/>
                                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Upd6" Style="{StaticResource Segment}" Content="6 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                        <RadioButton x:Name="Upd12" Style="{StaticResource Segment}" Content="12 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                        <RadioButton x:Name="Upd24" Style="{StaticResource Segment}" Content="24 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,16,0,0"
                                           Text="Ссылка хранится только на этом компьютере. Никому её не показывай — по ней можно пользоваться твоим VPN."/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Настройки -->
                        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Запуск" Style="{StaticResource H2}" Margin="0,8,0,4"/>
                                <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch}" Content="Запускать вместе с Windows" Click="OnSettingChanged"/>
                                <CheckBox x:Name="MinimizedCheck" Style="{StaticResource Switch}" Content="Запускать свёрнутым в трей" Click="OnSettingChanged"/>
                                <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource Switch}" Content="Подключаться сразу при запуске" Click="OnSettingChanged"/>

                                <TextBlock Text="О программе" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Body}" Foreground="{StaticResource SubText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Папка с данными" Click="OnOpenData"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Журнал -->
                        <Grid x:Name="PageLog" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource Card}" Foreground="{StaticResource SubText}" BorderThickness="0"
                                     FontFamily="{StaticResource Mono}" FontSize="11" Padding="10" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Копировать" Click="OnLogCopy"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================================================= всплывающее уведомление -->
            <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                    Background="#E61E2532" CornerRadius="12" Padding="16,10" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
            </Border>
        </Grid>
    </Border>
</Window>

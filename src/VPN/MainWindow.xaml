<Window x:Class="VPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN" Width="980" Height="660" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Ui}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Своя шапка, но окно обычное: тянется, прилипает к краям, рисуется видеокартой. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="IcoHome">M3,10 L12,3 L21,10 V20 H15 V14 H9 V20 H3 Z</Geometry>
        <Geometry x:Key="IcoServers">M4,5 H20 V10 H4 Z M4,14 H20 V19 H4 Z M7,7.5 H8 M7,16.5 H8</Geometry>
        <Geometry x:Key="IcoTunnels">M4,7 H14 L11,4 M14,7 L11,10 M20,17 H10 L13,14 M10,17 L13,20</Geometry>
        <Geometry x:Key="IcoSub">M10,14 L14,10 M8.5,16.5 L7,18 A3.5,3.5 0 0 1 2,13 L5.5,9.5 A3.5,3.5 0 0 1 10.5,9.5 M15.5,7.5 L17,6 A3.5,3.5 0 0 1 22,11 L18.5,14.5 A3.5,3.5 0 0 1 13.5,14.5</Geometry>
        <Geometry x:Key="IcoSettings">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>

        <!-- Строка сервера -->
        <DataTemplate x:Key="ServerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="26" CornerRadius="7" Background="#202838" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource SubText}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0"/>
                <Path Grid.Column="3" Data="M4,10 L8,14 L16,6" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="20" Height="20"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding CheckVisibility}"/>
            </Grid>
        </DataTemplate>

        <!-- Строка правила: программа или сайт -->
        <DataTemplate x:Key="RuleRow">
            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SubtitleVisibility}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnRuleToggle" Cursor="Hand" Margin="10,0,6,0" ToolTip="Нажми, чтобы переключить">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="9" Padding="12,5" Background="#1D3A2E">
                                    <TextBlock x:Name="ChipText" Text="через VPN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ViaVpn}" Value="False">
                                        <Setter TargetName="Chip" Property="Background" Value="#3A2E1D"/>
                                        <Setter TargetName="ChipText" Property="Text" Value="напрямую"/>
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Click="OnRuleDelete" ToolTip="Удалить">
                        <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Строка в окне выбора программ -->
        <DataTemplate x:Key="CandidateRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13"/>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= боковая панель -->
        <Border Background="#0A0D11" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                    <Ellipse Width="22" Height="22" Fill="{StaticResource AccentGradient}"/>
                    <TextBlock Text="VPN" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Мини-статус внизу панели -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" CornerRadius="12" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideStatus" Text="Отключено" Foreground="{StaticResource Text}" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="SideDetail" Text="" Foreground="{StaticResource Faint}" FontSize="11" Margin="16,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="Главная" Tag="{StaticResource IcoHome}" GroupName="Nav" IsChecked="True" Checked="OnNav"/>
                    <RadioButton x:Name="NavServers" Style="{StaticResource NavItem}" Content="Серверы" Tag="{StaticResource IcoServers}" GroupName="Nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavTunnels" Style="{StaticResource NavItem}" Content="Туннели" Tag="{StaticResource IcoTunnels}" GroupName="Nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavSub" Style="{StaticResource NavItem}" Content="Подписка" Tag="{StaticResource IcoSub}" GroupName="Nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Настройки" Tag="{StaticResource IcoSettings}" GroupName="Nav" Checked="OnNav"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================= содержимое -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка: перетаскивание окна системное (WindowChrome), кнопки — свои -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                <Button Style="{StaticResource IconButton}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть">
                    <Path Data="M5,10 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть">
                    <Path Data="M5.5,5.5 H14.5 V14.5 H5.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Спрятать в трей">
                    <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="32,0,32,24">

                <!-- ============================= Главная -->
                <Grid x:Name="PageHome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid x:Name="PowerButton" Width="200" Height="200" Cursor="Hand" Background="Transparent"
                              MouseLeftButtonUp="OnPowerClick" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <!-- Мягкое свечение: статичное, без бесконечных анимаций -->
                            <Ellipse x:Name="Glow" Width="200" Height="200" Opacity="0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowStop" Color="#553DDC97" Offset="0.62"/>
                                        <GradientStop Color="#003DDC97" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="170" Height="170" StrokeThickness="3">
                                <Ellipse.Stroke>
                                    <SolidColorBrush x:Name="RingBrush" Color="#2A3242"/>
                                </Ellipse.Stroke>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A2130" Offset="0"/>
                                        <GradientStop Color="#11161E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path x:Name="Spinner" Width="170" Height="170" Stretch="None" Opacity="0"
                                  Data="M85,1.5 A83.5,83.5 0 0 1 168.5,85" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{StaticResource Warn}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path Width="54" Height="54" Stretch="Uniform" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,3 V11 M7.05,6.05 A7,7 0 1 0 16.95,6.05">
                                <Path.Stroke>
                                    <SolidColorBrush x:Name="IconBrush" Color="#56607A"/>
                                </Path.Stroke>
                            </Path>
                        </Grid>

                        <TextBlock x:Name="StatusText" Text="Отключено" Style="{StaticResource H1}" FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="SubStatus" Text="Нажми на кнопку, чтобы подключиться" Style="{StaticResource Label}" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,6,0,0"/>

                        <!-- Выбранный сервер: клик — список серверов -->
                        <Button Click="OnOpenServers" Cursor="Hand" Margin="0,22,0,0" Width="380" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource Card}" CornerRadius="14" Padding="16,12" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#33405A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="26" CornerRadius="7" Background="#202838" Margin="0,0,12,0">
                                    <TextBlock x:Name="CurrentCode" Text="AUTO" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Сервер" Foreground="{StaticResource Faint}" FontSize="11"/>
                                    <TextBlock x:Name="CurrentServer" Text="Самый быстрый" Foreground="{StaticResource Text}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="CurrentPing" Grid.Column="2" Text="" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0"/>
                                <Path Grid.Column="3" Data="M8,5 L13,10 L8,15" Stroke="{StaticResource SubText}" StrokeThickness="1.8" Width="20" Height="20" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Плитки статистики -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Загрузка" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DownText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Polyline x:Name="DownLine" Stroke="{StaticResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Width="70" Height="22" Stretch="None" Opacity="0.8"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Отдача" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="UpText" Text="—" Style="{StaticResource Value}" FontSize="17" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Polyline x:Name="UpLine" Stroke="{StaticResource Accent2}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Width="70" Height="22" Stretch="None" Opacity="0.8"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Пинг · потери" Style="{StaticResource Label}"/>
                                <TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold">
                                    <Run x:Name="PingRun" Text="—" Foreground="{StaticResource Text}"/>
                                    <Run x:Name="LossRun" Text="" Foreground="{StaticResource SubText}" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Сессия" Style="{StaticResource Label}"/>
                                <TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                                    <Run x:Name="UptimeRun" Text="—"/>
                                    <Run x:Name="TotalRun" Text="" Foreground="{StaticResource SubText}" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- ============================= Серверы -->
                <DockPanel x:Name="PageServers" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PingAllButton" Style="{StaticResource GhostButton}" Content="Проверить пинг" Click="OnPingAll" Margin="0,0,8,0"/>
                            <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Content="Обновить подписку" Click="OnRefreshSubscription"/>
                        </StackPanel>
                        <TextBlock Text="Серверы" Style="{StaticResource H1}" FontSize="24"/>
                        <TextBlock x:Name="ServerCount" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                    </DockPanel>
                    <TextBox x:Name="ServerSearch" DockPanel.Dock="Top" Style="{StaticResource Input}" Tag="Поиск сервера…" TextChanged="OnServerSearch" Margin="0,0,0,12"/>
                    <ListBox x:Name="ServersList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ServerRow}" SelectionChanged="OnServerSelected"/>
                </DockPanel>

                <!-- ============================= Туннели -->
                <ScrollViewer x:Name="PageTunnels" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Туннели" Style="{StaticResource H1}" FontSize="24" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Выбери, что пускать через VPN, а что напрямую. Изменения применяются сразу."/>

                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModeAll" Style="{StaticResource ModeCard}" GroupName="Mode" Margin="0,0,8,0" Checked="OnModeChanged"
                                         Content="Всё через VPN" Tag="Через VPN идёт весь трафик, а то, что добавишь ниже, — напрямую."/>
                            <RadioButton x:Name="ModeSelected" Style="{StaticResource ModeCard}" GroupName="Mode" Margin="8,0,0,0" Checked="OnModeChanged"
                                         Content="Только выбранное" Tag="Через VPN идёт только то, что добавишь ниже, остальное — напрямую."/>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="RussiaCheck" Style="{StaticResource Switch}" Content="Российские сайты и сервисы напрямую" Click="OnTunnelOption" Margin="0,2"/>
                                <CheckBox x:Name="AdsCheck" Style="{StaticResource Switch}" Content="Блокировать рекламу и трекеры" Click="OnTunnelOption" Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- Программы -->
                        <DockPanel Margin="0,18,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Добавить программы" Click="OnPickerOpen" Padding="14,7"/>
                            <TextBlock Text="Программы" Style="{StaticResource H1}" FontSize="17" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource RuleRow}"/>
                        <TextBlock x:Name="AppsEmpty" Style="{StaticResource Label}" Margin="2,0,0,4"
                                   Text="Пока пусто. Например, добавь игры — они пойдут напрямую с низким пингом."/>

                        <!-- Сайты -->
                        <TextBlock Text="Сайты" Style="{StaticResource H1}" FontSize="17" Margin="0,18,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SiteInput" Style="{StaticResource Input}" Tag="Адрес сайта, например youtube.com — и Enter" KeyDown="OnSiteKey"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnSiteAdd" Margin="8,0,0,0" Padding="14,7"/>
                        </Grid>
                        <TextBlock Text="Быстро добавить:" Style="{StaticResource Label}" Margin="2,2,0,6"/>
                        <WrapPanel x:Name="Presets" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="SitesList" ItemTemplate="{StaticResource RuleRow}"/>
                        <TextBlock x:Name="SitesEmpty" Style="{StaticResource Label}" Margin="2,0,0,4" Text="Пока пусто."/>

                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,14,0,6"
                                   Text="Сайты важнее программ: если браузер идёт напрямую, а youtube.com — через VPN, YouTube в этом браузере пойдёт через VPN."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================= Подписка -->
                <ScrollViewer x:Name="PageSub" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Подписка" Style="{StaticResource H1}" FontSize="24" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SubUrl" Style="{StaticResource Input}" Tag="Вставь ссылку-подписку: https://…"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSubSave" Margin="8,0,0,0" Padding="16,7"/>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="SubExpireText" DockPanel.Dock="Right" Style="{StaticResource Label}" FontSize="13"/>
                                    <TextBlock x:Name="SubTitleText" Text="Подписка" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock x:Name="SubTrafficText" Text="не добавлена" Foreground="{StaticResource SubText}" FontSize="13" Margin="0,8,0,8"/>
                                <Grid Height="6">
                                    <Border Background="#232B38" CornerRadius="3"/>
                                    <Border x:Name="SubBar" Background="{StaticResource AccentGradient}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="SubInfo" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Обновлять автоматически" Style="{StaticResource H2}"/>
                        <Border Background="{StaticResource Card}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Upd6" Style="{StaticResource Segment}" Content="каждые 6 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                <RadioButton x:Name="Upd12" Style="{StaticResource Segment}" Content="12 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                                <RadioButton x:Name="Upd24" Style="{StaticResource Segment}" Content="24 ч" GroupName="Upd" Checked="OnUpdateInterval"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,0"
                                   Text="Ссылка хранится только на этом компьютере. Никому её не показывай — по ней можно пользоваться твоим VPN."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================= Настройки -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки" Style="{StaticResource H1}" FontSize="24" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch}" Content="Запускать вместе с Windows" Click="OnSettingChanged"/>
                                <CheckBox x:Name="MinimizedCheck" Style="{StaticResource Switch}" Content="Запускать свёрнутым в трей" Click="OnSettingChanged"/>
                                <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource Switch}" Content="Подключаться сразу при запуске" Click="OnSettingChanged"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Журнал" Click="OnLogOpen" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Папка с данными" Click="OnOpenData"/>
                        </StackPanel>
                        <TextBlock x:Name="AboutText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================= окно выбора программ -->
        <Grid x:Name="PickerOverlay" Grid.ColumnSpan="2" Background="#B3070A0E" Visibility="Collapsed">
            <Border Width="540" Height="500" Background="{StaticResource Panel}" CornerRadius="18" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="20">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnPickerClose">
                            <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                        </Button>
                        <TextBlock Text="Добавить программы" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Найти exe вручную…" Click="OnPickerBrowse"/>
                        <Button DockPanel.Dock="Right" x:Name="PickerAdd" Style="{StaticResource PrimaryButton}" Content="Добавить" Click="OnPickerAdd"/>
                        <TextBlock x:Name="PickerHint" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </DockPanel>
                    <TextBox x:Name="PickerSearch" DockPanel.Dock="Top" Style="{StaticResource Input}" Tag="Поиск: discord, chrome, steam…" TextChanged="OnPickerSearch" Margin="0,0,0,10"/>
                    <ListBox x:Name="PickerList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource CandidateRow}" SelectionMode="Single"
                             SelectionChanged="OnPickerRowClick"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================================= журнал -->
        <Grid x:Name="LogOverlay" Grid.ColumnSpan="2" Background="#B3070A0E" Visibility="Collapsed">
            <Border Margin="60,50" Background="{StaticResource Panel}" CornerRadius="18" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="20">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnLogClose">
                            <Path Data="M6,6 L14,14 M14,6 L6,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="20" Height="20"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Копировать" Click="OnLogCopy" Margin="0,0,8,0"/>
                        <TextBlock Text="Журнал" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource Card}" Foreground="{StaticResource SubText}" BorderThickness="0"
                             FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================================= уведомление -->
        <Border x:Name="Toast" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                Background="#F21E2532" CornerRadius="12" Padding="16,10" Opacity="0" IsHitTestVisible="False"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
        </Border>
    </Grid>
</Window>
